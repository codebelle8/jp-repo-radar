# Copy to .env.local for local use. On Vercel, add these in Project Settings → Environment Variables.

# GitHub personal access token (fine-grained, "Public repositories (read-only)", no other permissions).
# https://github.com/settings/personal-access-tokens/new
# Locally you can also paste it on the Settings page instead.
GITHUB_TOKEN=

# Password for editing and running jobs from the browser. Required on Vercel to enable editing;
# optional locally (without it, anyone on this computer can edit).
ADMIN_PASSWORD=

# Protects the daily cron endpoint (Vercel sends it automatically as a Bearer token).
CRON_SECRET=

# Storage on Vercel: connect Neon (Postgres) or "Upstash for Redis" in Vercel → Storage; it adds these automatically.
# DATABASE_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local storage folder (default: ./data)
# DATA_DIR=./data
